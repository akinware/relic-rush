{
  "installCommand": "npm ci",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)\\.glb", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
